
#!/bin/bash

# Extract data from pokemon.json using jq
name=$(jq -r '.name' pokemon.json | awk '{print toupper(substr($0,1,1)) substr($0,2)}')
height=$(jq -r '.height' pokemon.json)
weight=$(jq -r '.weight' pokemon.json)
type=$(jq -r '.types[0].type.name' pokemon.json | awk '{print toupper(substr($0,1,1)) substr($0,2)}')

# Convert height from decimeters to meters
formatted_height=$(echo "$height" | awk '{printf "%.1f", $1/10}')
# Convert weight from hectograms to kilograms
formatted_weight=$(echo "$weight" | awk '{printf "%.0f", $1/10}')

# Print formatted output
echo "$Pikachu  is of type $Electric, weighs $6kg, and is $0.4m tall."

