#!/bin/bash

output_dir="pokemon_data"
mkdir -p "$output_dir"

pokemon_list=("bulbasaur" "ivysaur" "venusaur" "charmander" "charmeleon")

pids=()  # Array to store background process PIDs

fetch_pokemon() {
    local pokemon=$1
    echo "Fetching data for $pokemon..."
    curl -s -f "https://pokeapi.co/api/v2/pokemon/$pokemon" -o "$output_dir/$pokemon.json"
    
    if [ $? -eq 0 ]; then
        echo "Saved data to $output_dir/$pokemon.json ✅"
    else
        echo "Failed to fetch data for $pokemon ❌" >> error_log.txt
    fi
}

# Launch all fetches in background and store PIDs
for pokemon in "${pokemon_list[@]}"; do
    fetch_pokemon "$pokemon" &
    pids+=($!)
done

# Wait for all background jobs and handle stuck processes
for pid in "${pids[@]}"; do
    wait $pid || kill $pid
done

echo "All Pokémon data fetched."

